<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <radialGradient id="bg" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#f472b6" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#db2777" stop-opacity="1"/>
    </radialGradient>
    <filter id="glow"><feGaussianBlur stdDeviation="4" result="blur"/><feComposite in="SourceGraphic" in2="blur" operator="over"/></filter>
  </defs>
  
  <path d="M 55 50 L 40 10 L 70 35 Z" fill="#ec4899" /><path d="M 145 50 L 160 10 L 130 35 Z" fill="#ec4899" /><circle cx="75" cy="90" r="12" fill="#f472b6" /><circle cx="125" cy="90" r="12" fill="#f472b6" />
  <!-- Main Body Blob -->
  <rect x="45" y="45" width="110" height="125" rx="45" fill="url(#bg)" filter="url(#glow)" stroke="#fbcfe8" stroke-width="3" />
  <!-- Eyes -->
  <circle cx="75" cy="95" r="9" fill="#0f172a" />
  <circle cx="125" cy="95" r="9" fill="#0f172a" />
  <circle cx="72" cy="92" r="3" fill="#ffffff" />
  <circle cx="122" cy="92" r="3" fill="#ffffff" />
  <!-- Mouth -->
  <path d="M 92 110 Q 100 118 108 110" fill="none" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" />
  <!-- Cheeks -->
  <circle cx="63" cy="105" r="7" fill="#f472b6" opacity="0.6" />
  <circle cx="137" cy="105" r="7" fill="#f472b6" opacity="0.6" />
</svg>